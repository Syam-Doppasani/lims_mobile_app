rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Lab logos — technician can upload their own
    match /logos/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024  // 2MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Generated PDF reports — only readable by authenticated users
    // (actual public access is via signed URL from Cloud Function)
    match /reports/{reportId}/{filename} {
      allow read: if request.auth != null;
      // Write only from Cloud Functions (uses admin SDK, bypasses rules)
      allow write: if false;
    }
  }
}
